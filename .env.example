# ============================================================================
# Private AI JEE/NEET Test Platform - Environment Configuration Template
# ============================================================================

# ----------------------------------------------------------------------------
# 1. CLIENT & PUBLIC CONFIGURATION (Safe for browser exposure)
# ----------------------------------------------------------------------------
# Supabase Project URL (e.g., https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (subject to Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NEVER prefix with NEXT_PUBLIC_ or commit to Git)
# ----------------------------------------------------------------------------
# Supabase Service Role Key (Bypasses RLS - used only for server background operations & initial seeding)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Gemini API Key for AI features (Question Ingestion, Paper Generation, Diagnostic Analysis)
GEMINI_API_KEY=AIzaSy...

# Google Gemini Model Identifier (Default production: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Node Environment
NODE_ENV=production
